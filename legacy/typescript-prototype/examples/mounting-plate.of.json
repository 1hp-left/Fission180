{
  "format": "openfusion",
  "version": 1,
  "name": "Mounting plate",
  "units": "mm",
  "parameters": { "width": 80, "height": 50, "thickness": 6, "holeRadius": 3.5, "bossRadius": 12, "bossHeight": 4, "boreRadius": 4 },
  "features": [
    { "id": "base-profile", "type": "sketch", "profile": { "type": "rectangle", "width": { "parameter": "width" }, "height": { "parameter": "height" } } },
    { "id": "base-extrude", "type": "extrude", "sketch": "base-profile", "distance": { "parameter": "thickness" }, "body": "plate" },
    { "id": "hole-1", "type": "sketch", "profile": { "type": "circle", "radius": { "parameter": "holeRadius" }, "center": [-30, -15] } },
    { "id": "cut-1", "type": "extrude", "sketch": "hole-1", "distance": { "parameter": "thickness" }, "operation": "cut", "body": "plate" },
    { "id": "hole-2", "type": "sketch", "profile": { "type": "circle", "radius": { "parameter": "holeRadius" }, "center": [30, -15] } },
    { "id": "cut-2", "type": "extrude", "sketch": "hole-2", "distance": { "parameter": "thickness" }, "operation": "cut", "body": "plate" },
    { "id": "hole-3", "type": "sketch", "profile": { "type": "circle", "radius": { "parameter": "holeRadius" }, "center": [30, 15] } },
    { "id": "cut-3", "type": "extrude", "sketch": "hole-3", "distance": { "parameter": "thickness" }, "operation": "cut", "body": "plate" },
    { "id": "hole-4", "type": "sketch", "profile": { "type": "circle", "radius": { "parameter": "holeRadius" }, "center": [-30, 15] } },
    { "id": "cut-4", "type": "extrude", "sketch": "hole-4", "distance": { "parameter": "thickness" }, "operation": "cut", "body": "plate" },
    { "id": "boss-profile", "type": "sketch", "origin": [0, 0, { "parameter": "thickness" }], "profile": { "type": "circle", "radius": { "parameter": "bossRadius" } } },
    { "id": "boss-extrude", "type": "extrude", "sketch": "boss-profile", "distance": { "parameter": "bossHeight" }, "operation": "join", "body": "plate" },
    { "id": "bore-profile", "type": "sketch", "origin": [0, 0, -1], "profile": { "type": "circle", "radius": { "parameter": "boreRadius" } } },
    { "id": "bore-cut", "type": "extrude", "sketch": "bore-profile", "distance": 100, "operation": "cut", "body": "plate" }
  ]
}
